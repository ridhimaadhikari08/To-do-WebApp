Step 5: HTML Template (todo/templates/todo/list.html)
<!DOCTYPE html>
<html>
<head>
    <title>Django Todo App</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .todo-container {
            width: 400px;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        h2 { text-align: center; margin-bottom: 20px; }
        .input-group { display: flex; gap: 10px; margin-bottom: 20px; }
        .input-group input { flex: 1; padding: 10px; border-radius: 6px; border: 1px solid #ccc; }
        .btn { padding: 8px 12px; border: none; border-radius: 6px; cursor: pointer; }
        .add-btn { background: #6c5ce7; color: white; }
        .task { display: flex; justify-content: space-between; align-items: center; padding: 10px; background: #f9f9f9; border-radius: 6px; margin-bottom: 10px; }
        .task-text { flex: 1; }
        .edit-form { display: flex; gap: 5px; flex: 1; }
        .btn-edit { background: #f39c12; color: white; }
        .btn-delete { background: #e74c3c; color: white; }
        .btn-save { background: #2ecc71; color: white; }
        .footer { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; }
        .clear-btn { background: #e74c3c; color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="todo-container">
        <h2>Todo List</h2>

        <!-- ADD TASK -->
        <form method="POST">
            {% csrf_token %}
            <div class="input-group">
                <input type="text" name="title" placeholder="Add a new task..." required>
                <button type="submit" name="add_task" class="btn add-btn">+</button>
            </div>
        </form>

        <!-- TASK LIST -->
        {% for todo in todos %}
            <div class="task">
                <!-- DISPLAY TEXT -->
                <div id="text-{{ todo.id }}" class="task-text">{{ todo.title }}</div>

                <!-- EDIT FORM (Hidden by default) -->
                <form method="POST" id="edit-{{ todo.id }}" class="edit-form" style="display:none;">
                    {% csrf_token %}
                    <input type="hidden" name="task_id" value="{{ todo.id }}">
                    <input type="text" name="new_title" value="{{ todo.title }}" required>
                    <button type="submit" name="edit_task" class="btn btn-save">✔</button>
                </form>

                <!-- BUTTONS -->
                <div style="display: flex; gap: 5px;">
                    <button type="button" onclick="enableEdit({{ todo.id }})" class="btn btn-edit">✏</button>
                    <form method="POST" style="margin: 0;">
                        {% csrf_token %}
                        <input type="hidden" name="task_id" value="{{ todo.id }}">
                        <button type="submit" name="delete_task" class="btn btn-delete">🗑</button>
                    </form>
                </div>
            </div>
        {% empty %}
            <p style="text-align: center; color: #888;">No tasks yet!</p>
        {% endfor %}

        <!-- FOOTER -->
        <div class="footer">
            <span>Tasks: {{ task_count }}</span>
            {% if task_count > 0 %}
                <form method="POST" style="margin: 0;">
                    {% csrf_token %}
                    <button type="submit" name="clear_all" class="clear-btn">Clear All</button>
                </form>
            {% endif %}
        </div>
    </div>

    <script>
        function enableEdit(id) {
            document.getElementById("text-" + id).style.display = "none";
            document.getElementById("edit-" + id).style.display = "flex";
        }
    </script>
</body>
</html>

